    "settings.summary.allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS allows it on the lock screen"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS מתיר אותו במסך הנעילה"
          }
        }
      }
    },
    "settings.summary.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds the day as one standing notification. It needs no widget and no shared container, so it works where the lock-screen card cannot. It does not tick like the card does, and its Done button needs a long press rather than a tap."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחזיק את היום כהתראה אחת קבועה. לא נדרש ווידג’ט ולא מכל משותף, ולכן זה עובד גם היכן שכרטיס מסך הנעילה לא יכול. זה לא מתעדכן בזמן אמת כמו הכרטיס, וכפתור \"בוצע\" דורש לחיצה ארוכה ולא הקשה."
          }
        }
      }
    },
    "settings.summary.postNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post it to the lock screen now"
