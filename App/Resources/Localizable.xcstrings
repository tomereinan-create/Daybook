            "value": "שלושה דברים לאשר"
          }
        }
      }
    },
    "onboarding.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
