    "widget.unavailable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Daybook once to fix this."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Daybook פעם אחת כדי לתקן."
          }
        }
      }
    },
    "widget.unavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read your day"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לקרוא את היום"
          }
        }
      }
    },
    "widgetSetup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widget is the point. Put it where your apps are now, and move the apps to page two."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הווידג׳ט הוא העיקר. שימו אותו במקום האפליקציות, והעבירו אותן לעמוד השני."
          }
        }
      }
    },
    "widgetSetup.finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיום"
          }
        }
      }
    },
    "widgetSetup.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold an empty part of your home screen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו ארוכות על אזור ריק במסך הבית."
          }
        }
      }
    },
    "widgetSetup.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Edit, then Add Widget, and find Daybook."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על עריכה, אחר כך הוספת ווידג׳ט, ומצאו את Daybook."
          }
        }
      }
    },
    "widgetSetup.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the large one, then the medium one below it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו את הגדול, ואז את הבינוני מתחתיו."
          }
        }
      }
    },
    "widgetSetup.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag everything else to page two."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גררו את כל השאר לעמוד השני."
          }
        }
      }
    },
    "widgetSetup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it the first page"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תנו לו את העמוד הראשון"
          }
        }
      }
    },
    "widgetSetup.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS caps a single widget at four rows of a six-row page. A large one plus a medium one fills it, and both read the same day so they can never disagree."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS מגביל ווידג׳ט בודד לארבע שורות מתוך עמוד של שש. גדול ובינוני יחד ממלאים אותו, ושניהם קוראים את אותו יום ולכן לא יכולים לסתור זה את זה."
          }
        }
      }
    }
  },
  "version": "1.0"
}
