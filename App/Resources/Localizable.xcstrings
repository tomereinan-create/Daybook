    "editor.silent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one will never alert you. It has no time to alert at, or its alert is set to show only — change Triggered by, or Alert under Advanced."
