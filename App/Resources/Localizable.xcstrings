      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It sits with your notifications at the foot of the lock screen, not in the widget area at the top. If your lock screen is set to show notifications as a count or a stack, swipe up from the bottom to open them."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא יושב יחד עם ההתראות בתחתית מסך הנעילה, לא באזור הווידג’טים למעלה. אם מסך הנעילה מוגדר להציג התראות כמספר או כערימה, החליקו מלמטה למעלה כדי לפתוח אותן."
          }
        }
      }
    },
    "settings.test.blocked": {
