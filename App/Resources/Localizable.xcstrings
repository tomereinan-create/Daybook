    "widgetSetup.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS caps a single widget at four rows of a six-row page. A large one plus a medium one fills it, and both read the same day so they can never disagree."
          }
