            "value": "%lld מתוך %lld בוצעו"
          }
        }
      }
    },
    "widget.today.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your day, with a circle to tick each thing off."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היום שלכם, עם עיגול לסימון כל דבר."
