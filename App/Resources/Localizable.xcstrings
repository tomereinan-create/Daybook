      }
    },
    "preset.flexibleHabit.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few times a week, whenever suits you. Nudges only if you fall behind."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה פעמים בשבוע, מתי שמתאים. מזכיר רק אם נשארתם מאחור."
          }
        }
      }
    },
    "preset.timeBlock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time block"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלוק זמן"
          }
        }
      }
    },
    "preset.timeBlock.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appears when it starts, counts down, then goes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מופיע כשמתחיל, סופר לאחור, ואז נעלם."
          }
        }
      }
    },
    "preset.relativeTimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיימר"
          }
        }
      }
    },
    "preset.relativeTimer.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You start it, it tells you when the time is up. The laundry, the oven."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתם מתחילים, והוא אומר כשהזמן נגמר. הכביסה, התנור."
          }
        }
      }
    },
    "preset.routine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שגרה"
          }
        }
      }
    },
    "preset.routine.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A list of steps in order. Shows you one at a time."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימת שלבים לפי סדר. מציג אחד בכל פעם."
          }
        }
      }
    },
    "preset.waitingFor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין ל"
          }
        }
      }
    },
    "preset.waitingFor.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else has the ball. Nudges you to chase it up."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכדור אצל מישהו אחר. מזכיר לכם לבדוק מה קורה."
          }
        }
      }
    },
    "preset.someday": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someday"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתישהו"
          }
        }
      }
    },
    "preset.someday.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out of sight until you sit down and review."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחוץ לעיניים עד שתשבו לעבור על הרשימה."
          }
        }
      }
    },
    "preset.wakeUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake-up"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השכמה"
          }
        }
      }
    },
    "preset.wakeUp.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real alarm. Dismissing it starts your day."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שעון מעורר אמיתי. כשמכבים אותו היום מתחיל."
          }
        }
      }
    }
  },
  "version": "1.0"
}
