    "onboarding.intro.alerts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts as loud as the thing deserves, and no louder"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראות חזקות כמו שמגיע לדבר, ולא יותר"
          }
        }
      }
    },
    "onboarding.intro.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daybook lives on the screens you already look at. You only come in here to write things down."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Daybook חי במסכים שאתם ממילא מסתכלים בהם. נכנסים לכאן רק כדי לרשום דברים."
          }
        }
      }
    },
    "onboarding.intro.homeScreen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A widget filling your first home page"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ווידג׳ט שממלא את עמוד הבית הראשון"
          }
        }
      }
    },
    "onboarding.intro.lockScreen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card on your lock screen with the current thing and a Done button"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כרטיס במסך הנעילה עם הדבר הנוכחי וכפתור בוצע"
          }
        }
      }
    },
    "onboarding.intro.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your day, without opening this"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היום שלכם, בלי לפתוח את זה"
          }
        }
      }
    },
    "onboarding.next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבא"
          }
        }
      }
    },
    "onboarding.permissions.alarms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms, so a wake-up rings through silent mode"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שעון מעורר, כדי שהשכמה תצלצל גם במצב שקט"
          }
        }
      }
    },
    "onboarding.permissions.ask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאשר"
          }
        }
      }
    },
    "onboarding.permissions.asked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תודה"
          }
        }
      }
    },
    "onboarding.permissions.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuse any of them and the app still works. Here is what each one buys you."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לסרב לכל אחד והאפליקציה עדיין עובדת. הנה מה שכל אחד נותן."
          }
        }
      }
    },
    "onboarding.permissions.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change any of this later in Settings."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשנות כל זאת בהמשך בהגדרות."
          }
        }
      }
    },
    "onboarding.permissions.notifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications, so something can reach you when it matters"
          }
        },
        "he": {
