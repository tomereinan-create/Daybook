    "settings.diag.fallbackStore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widget and the lock-screen card run in a separate process and read your data through a shared container. This build was not granted one, so they will look empty however many items you have. It needs a paid Apple developer account, or a sideloading tool that registers the app group."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הווידג’ט וכרטיס מסך הנעילה רצים בתהליך נפרד וקוראים את הנתונים דרך מכל משותף. לבנייה הזו לא ניתן מכל כזה, ולכן הם ייראו ריקים לא משנה כמה פריטים יש. נדרש חשבון מפתח בתשלום, או כלי התקנה שרושם את קבוצת האפליקציות."
          }
        }
      }
    },
    "settings.diag.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS holds 64 pending notifications per app, so the nearest ones are queued and the rest follow later."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS מחזיק 64 התראות ממתינות לאפליקציה, ולכן הקרובות נכנסות לתור והשאר אחריהן."
          }
        }
      }
    },
